// Realtime Database security rules for ScrumEstimate.
//
// These are not deployed by anything in this repo — paste them into
// Firebase console → Build → Realtime Database → Rules and publish.
// Nothing here takes effect until you do, and until the Anonymous sign-in
// provider is enabled under Build → Authentication → Sign-in method.
//
// Two Firebase behaviours drive the shape of this file:
//   - .read / .write cascade DOWNWARD. Granting either at a node grants it for
//     everything beneath, and a deeper rule cannot take it back. That is why
//     there is no .read on rooms/$code itself: it would carry read access to
//     the votes with it.
//   - .validate does not cascade and cannot grant anything, but it is enforced
//     on every write regardless of who authorised it — including the
//     facilitator's. It is what bounds how much data anyone can store.

{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {

      // The room list itself stays unreadable, with one exception: the query
      // below, which returns the oldest rooms whose last activity is already
      // past the TTL. It is what lets the create page collect abandoned rooms
      // with no scheduled job — see sweepAbandonedRooms() in js/firebase-core.js.
      //
      // Gating a .read on the query grants nothing else. Reading a single room's
      // votes is not a query, so query.orderByChild is null there, this
      // expression is false, and the rules below decide as before. The bounds are
      // checked against the server clock, so the window cannot be widened from
      // the client; each "> 0" pins a parameter to a number rather than trusting
      // how an unset one compares.
      //
      // What it does expose is the full contents of rooms already past the TTL,
      // votes included — abandoned data, on its way to being deleted.
      ".read": "auth != null && query.orderByChild === 'meta/lastActiveAt' && query.endAt > 0 && query.endAt <= now - 86400000 && query.limitToFirst > 0 && query.limitToFirst <= 25",
      ".indexOn": "meta/lastActiveAt",

      // Knowing a code is still the only way into a room that is not yet stale.

      "$code": {

        // Three legitimate whole-room writes: creating a room (the creator must
        // name themselves facilitator), the facilitator mutating their own room
        // (reveal, clear every vote on a new round, kick, delete), and anyone
        // garbage-collecting a room idle for more than 24h.
        //
        // The facilitator branch deliberately cascades: clearing everyone's vote
        // on a new round means writing nodes they do not own. .validate still
        // applies to every one of those writes.
        ".write": "auth != null && $code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/) && ( (!data.exists() && newData.exists() && newData.child('meta/facilitatorUid').val() === auth.uid) || (data.child('meta/facilitatorUid').val() === auth.uid) || (!newData.exists() && data.child('meta/lastActiveAt').val() < now - 86400000) )",
        ".validate": "newData.hasChildren(['meta', 'participants'])",

        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['code', 'revealed', 'facilitatorUid', 'createdAt', 'lastActiveAt'])",

          "code":           { ".validate": "newData.isString() && newData.val() === $code" },
          "revealed":       { ".validate": "newData.isBoolean()" },

          // Set once, at creation, and frozen. This is the whole of facilitator
          // privilege — there is no isFacilitator flag anywhere to forge.
          "facilitatorUid": { ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())" },
          "createdAt":      { ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())" },

          // Writable by any participant, so voting keeps the room alive, but only
          // ever to the server clock: it cannot be backdated to force the
          // stale-room delete below, nor postdated to outlive the TTL.
          "lastActiveAt": {
            ".write": "auth != null && data.parent().child('code').exists()",
            ".validate": "newData.val() === now"
          },

          "$other": { ".validate": false }
        },

        "participants": {
          ".read": "auth != null",

          "$pid": {

            // You may create a node that names you as its owner, and after that
            // write only your own. ownerUid is frozen on first write, so nobody
            // can adopt, edit or delete someone else's participant.
            ".write": "auth != null && ( (!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid )",
            ".validate": "$pid.matches(/^[a-z0-9]{1,24}$/) && newData.hasChildren(['id', 'name', 'ownerUid', 'hasVoted', 'connected', 'joinedAt'])",

            "id":        { ".validate": "newData.isString() && newData.val() === $pid" },
            "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "ownerUid":  { ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())" },
            "hasVoted":  { ".validate": "newData.isBoolean()" },
            "connected": { ".validate": "newData.isBoolean()" },
            "joinedAt":  { ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())" },

            "$other":    { ".validate": false }
          }
        },

        // Votes live outside the participant list so they can actually be hidden.
        // The collection becomes readable only once revealed is true; before that
        // each client can read exactly one vote — their own, via the $pid rule.
        "votes": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('revealed').val() === true",

          "$pid": {
            ".read": "auth != null && root.child('rooms').child($code).child('participants').child($pid).child('ownerUid').val() === auth.uid",

            // Own vote only, and not after the reveal — except to delete it,
            // so leaving a revealed room still takes your vote with you.
            ".write": "auth != null && root.child('rooms').child($code).child('participants').child($pid).child('ownerUid').val() === auth.uid && (root.child('rooms').child($code).child('meta').child('revealed').val() !== true || !newData.exists())",

            // Restricted to the actual card values: no arbitrary payloads here.
            ".validate": "newData.isString() && root.child('rooms').child($code).child('participants').child($pid).exists() && (newData.val() === '0' || newData.val() === '1' || newData.val() === '2' || newData.val() === '3' || newData.val() === '5' || newData.val() === '8' || newData.val() === '13' || newData.val() === '21' || newData.val() === '?' || newData.val() === '☕')"
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
